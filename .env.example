# StockGPT local environment contract
#
# Copy this file to .env.local. Never commit .env.local or any real credential.
# The compile/build quality gate succeeds without production credentials. Runtime
# features require the corresponding local, test or staging configuration below.
# Only NEXT_PUBLIC_* values are browser-exposed; every other credential is server-only.

# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase runtime configuration
# Required for authentication and database-backed application features.
# Once the canonical local schema is ready, obtain development values from
# `npm run supabase:start`; do not copy generated values into this tracked file.
# Never use the production service-role credential for local development or
# Vercel staging. Production credentials are not needed for routine local work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy server-only fallback read by the financial-metrics route. Prefer
# SUPABASE_SERVICE_ROLE_KEY and leave this unset unless compatibility requires it.
# SUPABASE_SERVICE_KEY=

# Stripe server-only configuration
# Required only for the corresponding checkout, billing-portal or webhook flows.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_LIMITED_OFFER_PRICE_ID=
STRIPE_CORE_ANNUAL_PRICE_ID=

# Optional Stripe behavior. Trial days must be a positive whole number.
# STRIPE_CORE_TRIAL_DAYS=14
STRIPE_PROMO_50_FIRST_MONTH=

# OpenRouter server-only configuration
# Required for Ask StockGPT and AI-generated digest content.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODELS=model-one,model-two

# Resend and email configuration
# RESEND_API_KEY is optional for most transactional mail (mail is skipped when absent)
# but required when running the digest sender.
RESEND_API_KEY=
# Optional sender overrides; leave absent to retain the current code defaults.
# EMAIL_FROM
# SUPPORT_EMAIL_FROM
# FOUNDER_ALERT_EMAIL
DIGEST_FROM_EMAIL=
AFFILIATE_NOTIFY_EMAIL=

# Optional news provider
# Google News RSS needs no key; NewsAPI enrichment is enabled only when this is set.
NEWS_API_KEY=

# Optional Upstash Redis cache
# Leave both unset to use database/in-process fallbacks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron and security configuration
# CRON_SECRET secures manual cron calls. Vercel supplies its own cron metadata.
CRON_SECRET=
# Set a different high-entropy server-only salt in each deployed environment.
RATE_LIMIT_SALT=

# Optional FX override and tuning
# Frankfurter requires no key; fixed application fallbacks are used on failure.
STOCKGPT_USD_FX_RATES_JSON=
# STOCKGPT_FX_REVALIDATE_SECONDS=21600
# STOCKGPT_FX_TIMEOUT_MS=1500

# Optional Redis/cache tuning
# REDIS_COMMAND_TIMEOUT_MS=700
# REDIS_DISABLED_COOLDOWN_MS=60000
# MAX_REDIS_VALUE_BYTES=750000
# NOTIFICATION_SUMMARY_TTL_MS=900000
# RANKING_SECTORS_CACHE_TTL_MS=300000

# Optional Yahoo/market-data tuning (Yahoo access requires no repository API key)
# YAHOO_FETCH_TIMEOUT_MS=1800
# ONE_DAY_MOVE_TIMEOUT_MS=1800
# LIVE_MOVE_FALLBACK_LIMIT=60
# MARKET_SNAPSHOT_BATCH_SIZE=10
# MARKET_SNAPSHOT_MAX_TICKERS=520
# PRIORITY_MARKET_SNAPSHOT_LIMIT=180
# PRIORITY_MARKET_SNAPSHOT_BATCH_SIZE=12

# Optional portfolio cache/snapshot tuning
# Numeric values are commented out so an empty string cannot override code defaults.
# PORTFOLIO_CHART_CACHE_TTL_SECONDS=900
# PORTFOLIO_PAGE_CHART_CACHE_ENABLED=1
# PORTFOLIO_CHART_LATEST_POINT_MAX_AGE_MS=
# PORTFOLIO_SNAPSHOT_TTL_MS=900000
# PORTFOLIO_SHARED_CACHE_TTL_SECONDS=600
# PORTFOLIO_STALE_SNAPSHOT_MAX_AGE_MS=86400000
# PORTFOLIO_REFRESH_LOCK_TTL_SECONDS=90
# PORTFOLIO_SNAPSHOT_READ_LIMIT=10000
# PORTFOLIO_SNAPSHOT_REFRESH_LIMIT=250
# PORTFOLIO_SNAPSHOT_REFRESH_BATCH_SIZE=25
# PORTFOLIO_CACHE_WARM_PORTFOLIO_LIMIT=25
# PORTFOLIO_CACHE_WARM_TRANSACTION_LIMIT=5000
# PORTFOLIO_REPAIR_TRANSACTION_LIMIT=5000
# PORTFOLIO_BACKFILL_CANDIDATE_LIMIT=50
# PORTFOLIO_BACKFILL_LIMIT=2
# PORTFOLIO_BACKFILL_LIVE_BUFFER_MS=600000
# PORTFOLIO_BACKFILL_TRANSACTION_LIMIT=10000
# PORTFOLIO_HEALTH_PORTFOLIO_LIMIT=500
# PORTFOLIO_HEALTH_REPAIR_LIMIT=2
# PORTFOLIO_HEALTH_LIVE_REPAIR_LIMIT=20
# PORTFOLIO_HEALTH_STALE_LIVE_MS=
# PORTFOLIO_HEALTH_MIN_HISTORY_AGE_MS=
# PORTFOLIO_HEALTH_SNAPSHOT_SCAN_LIMIT=25000
# PORTFOLIO_HEALTH_TRANSACTION_SCAN_LIMIT=25000

# Optional portfolio technical enrichment; disabled unless explicitly true.
# PORTFOLIO_TECHNICAL_CHARTS=true

# Framework/platform variables are supplied automatically; do not set them here:
# NODE_ENV, VERCEL, VERCEL_ENV

# Android signing values are GitHub Actions secrets, not .env.local values:
# ANDROID_KEYSTORE_BASE64, ANDROID_KEY_ALIAS,
# ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_PASSWORD
